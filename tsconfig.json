{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "outDir": "dist",
    "baseUrl": ".",
    "types": ["node", "vitest/globals"],
    "paths": {
      "@finance/domain/*": ["packages/domain/src/*"],
      "@finance/application/*": ["packages/application/src/*"],
      "@finance/infrastructure/*": ["packages/infrastructure/src/*"],
      "@finance/agent/*": ["packages/agent/src/*"],
      "@finance/shared/*": ["packages/shared/src/*"]
    }
  },
  "include": ["apps", "packages", "tests", "vitest.config.ts"]
}
